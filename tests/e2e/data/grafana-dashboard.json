{
  "title": "Conproxy Dashboard",
  "panels": [
    {
      "id": 1,
      "title": "Cache Hit Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(conproxy_cache_hits_total[5m]) / rate(conproxy_cache_requests_total[5m])"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(conproxy_request_duration_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Upstream Health",
      "type": "stat",
      "targets": [
        {
          "expr": "conproxy_upstream_failures_total"
        }
      ]
    }
  ]
}
